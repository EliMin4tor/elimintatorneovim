# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher
set $menu wmenu-run
# theme from /usr/share/rofi/themes
set $menu "rofi -combi-modi window,drun,ssh,run -show combi -show-icons -theme example"

### View
font pango:Noto Sans Mono Nerd Font 11
gaps inner 2
gaps outer -2
hide_edge_borders smart

# https://www.nordtheme.com/docs/colors-and-palettes/
set $polarNightLight   #2e3440
set $polarNightMedium  #3b4252
set $polarNightBright  #434c5e
set $polarNightStrong  #4c566a
set $snowStormLight    #d8dee9
set $snowStormMedium   #e5e9f0
set $snowStormBright   #eceff4
set $frostGreen        #8fbcbb
set $frostCyan         #88c0d0
set $frostBlue         #81a1c1
set $frostDeepBlue     #5e81ac
set $auroraRed         #bf616a
set $auroraOrange      #d08770
set $auroraYellow      #ebcb8b
set $auroraGreen       #a3be8c
set $auroraPurple      #b48ead
set $opacity           E0

# Set Colors:           Border              Background                  Text                 Indicator             Child Border
client.background                           $polarNightMedium
client.focused          $frostDeepBlue      $polarNightMedium$opacity   $snowStormMedium     $polarNightStrong     $polarNightLight
client.focused_inactive $polarNightStrong   $polarNightMedium$opacity   $snowStormLight      $polarNightStrong     $polarNightStrong
client.unfocused        $polarNightStrong   $polarNightLight$opacity    $snowStormLight      $polarNightStrong
client.urgent           $auroraPurple       $auroraOrange               $polarNightBright    $polarNightStrong     $auroraRed        

